// ApuntadorTEST - Simulador de Mira para probar la tarjeta de Sensores con un kit
// Muestra su MAC, anuncia 5s/descansa 8s (parpadeando LED SIO17) hasta conectar.
// Ya conectado, sigue el protocolo de aplicacion de la tabla Mira/Sensores:
//   Sensores -> CONF<datos>   : lo guarda, lo imprime, responde ACKCONF
//   Sensores -> RUN           : responde ACKRUN, arranca telemetria A_AP cada 10s
//   (cada 10s)  -> A_AP<n1>,<n2>  (n1 de 1 en 1, n2 de 2 en 2)
//   a los 2 min -> manda END_A y termina
//   Sensores -> END_S (antes de los 2 min) : responde ACKEND_S y termina
// Todo lo que llega por BLE se imprime en la terminal (para ver ACKs, etc).
// Los mensajes van sin $ ni \r por el aire (igual que hace Apuntador.sb con su UART);
// aqui el "envio" real es directo por GATT notify, ya que este archivo hace de
// transporte Y de logica de aplicacion en uno solo, para simular a Mira completo.

DIM rc
DIM addr$   : addr$ = ""
DIM adRpt$  : adRpt$ = ""
DIM scRpt$  : scRpt$ = ""
DIM hConn    : hConn = -1
DIM hSvc
DIM hCharRx
DIM hCharTx
DIM ntfyEnabled : ntfyEnabled = 0
DIM ledState : ledState = 0
DIM nAttributeMTU : nAttributeMTU = 23
DIM nAttributeLength
DIM nBleMaxPacketLength

DIM confRecibido : confRecibido = 0
DIM runRecibido  : runRecibido = 0
DIM terminado    : terminado = 0
DIM apCount      : apCount = 0

DIM pendienteMsg$ : pendienteMsg$ = ""
DIM apPendiente$  : apPendiente$ = ""

// "Estructura" con los campos de CONF: orden,lora,equipo,alias,vidas,municion,tiempo,mac
DIM cfOrden$    : cfOrden$ = ""
DIM cfLora$     : cfLora$ = ""
DIM cfEquipo$   : cfEquipo$ = ""
DIM cfAlias$    : cfAlias$ = ""
DIM cfVidas$    : cfVidas$ = ""
DIM cfMunicion$ : cfMunicion$ = ""
DIM cfTiempo$   : cfTiempo$ = ""
DIM cfMac$      : cfMac$ = ""

#define ATTRIBUTE_MTU_KEY_ID            211
#define ATTRIBUTE_DATA_LENGTH_KEY_ID    212
#define USE_STRINT_IN_EVENTS_KEY_ID     213
#define ENABLE_HIGH_BANDWIDTH_KEY_ID    214
#define BLE_MAX_PACKET_LENGTH_KEY_ID    216

#define ATTRIBUTE_MTU_MAXIMUM           247
#define ATTRIBUTE_DATA_LENGTH_MAXIMUM   244
#define BLE_MAX_PACKET_LENGTH           251

#define ADV_ON_MS   5000
#define ADV_OFF_MS  8000
#define MSG_DELAY_MS 150
#define AP_INTERVAL_MS 10000
#define FIN_TIMEOUT_MS 120000

FUNCTION ConfigurarDLE()
    rc = NvCfgKeyGet(ATTRIBUTE_MTU_KEY_ID, nAttributeMTU)
    rc = NvCfgKeyGet(ATTRIBUTE_DATA_LENGTH_KEY_ID, nAttributeLength)
    rc = NvCfgKeyGet(BLE_MAX_PACKET_LENGTH_KEY_ID, nBleMaxPacketLength)
    IF (nAttributeMTU != ATTRIBUTE_MTU_MAXIMUM) || (nAttributeLength != ATTRIBUTE_DATA_LENGTH_MAXIMUM) || (nBleMaxPacketLength != BLE_MAX_PACKET_LENGTH) THEN
        rc = NvCfgKeySet(ATTRIBUTE_MTU_KEY_ID, ATTRIBUTE_MTU_MAXIMUM)
        rc = NvCfgKeySet(ATTRIBUTE_DATA_LENGTH_KEY_ID, ATTRIBUTE_DATA_LENGTH_MAXIMUM)
        rc = NvCfgKeySet(USE_STRINT_IN_EVENTS_KEY_ID, 1)
        rc = NvCfgKeySet(ENABLE_HIGH_BANDWIDTH_KEY_ID, 1)
        rc = NvCfgKeySet(BLE_MAX_PACKET_LENGTH_KEY_ID, BLE_MAX_PACKET_LENGTH)
        Reset(0)
    ENDIF
ENDFUNC 0

PRINT "\n=== ApuntadorTEST arrancando ===\n"

rc = ConfigurarDLE()
rc = GpioSetFunc(17, 2, 0)
BleVSpClose()

// Mostrar MAC propia
DIM macFull$
macFull$ = SysInfo$(4)
macFull$ = StrHexize$(macFull$)
PRINT "\nMAC propia: "; macFull$; "\n"

// Crear servicio GATT (mismo 0x18EE que Apuntador.sb)
rc = BleServiceNew(1, BleHandleUuid16(0x18EE), hSvc)

DIM rxAttr$ : rxAttr$ = ""
rc = BleCharNew(0x0A, BleHandleUuid16(1), BleAttrMetaData(1,1,244,0,rc), 0, 0)
rc = BleCharCommit(hSvc, rxAttr$, hCharRx)

DIM txAttr$ : txAttr$ = ""
DIM mdCccd
mdCccd = BleAttrMetaData(1,1,2,0,rc)
rc = BleCharNew(0x12, BleHandleUuid16(2), BleAttrMetaData(1,0,244,0,rc), mdCccd, 0)
rc = BleCharCommit(hSvc, txAttr$, hCharTx)

rc = BleServiceCommit(hSvc)
PRINT "\nApuntadorTEST listo, iniciando ciclo de advertising\n"

FUNCTION IniciarAdvertising()
    rc = BleAdvRptInit(adRpt$, 2, 0, 20)
    rc = BleAdvRptsCommit(adRpt$, scRpt$)
    rc = BleAdvertStart(0, addr$, 100, ADV_ON_MS, 0)
    IF rc == 0 THEN
        PRINT "\nAnunciando (5s)..."
        TimerStart(1, 500, 1)
    ELSE
        PRINT "\nERROR BleAdvertStart rc="
        PRINT rc
        PRINT "\n"
    ENDIF
ENDFUNC 1

// Parpadeo de LED mientras se anuncia
FUNCTION HndlrTmr1()
    ledState = !ledState
    GpioWrite(17, ledState)
ENDFUNC 1

// Nadie se conecto en 5s -> apagar LED, descansar 8s
FUNCTION HndlrAdvTimeout()
    TimerCancel(1)
    GpioWrite(17, 0)
    PRINT "\nDescansando (8s)..."
    TimerStart(2, ADV_OFF_MS, 0)
ENDFUNC 1

// Termino el descanso -> anunciar de nuevo
FUNCTION HndlrTmr2()
    rc = IniciarAdvertising()
ENDFUNC 1

FUNCTION HndlrBleMsg(BYVAL nMsgId AS INTEGER, BYVAL nCtx AS INTEGER)
    SELECT nMsgId
        CASE 0
            hConn = nCtx
            TimerCancel(1)
            TimerCancel(2)
            GpioWrite(17, 0)
            ntfyEnabled = 0
            confRecibido = 0
            runRecibido = 0
            terminado = 0
            PRINT "\nConectado (sin acciones extra)"
        CASE 1
            hConn = -1
            ntfyEnabled = 0
            confRecibido = 0
            runRecibido = 0
            TimerCancel(3)
            TimerCancel(4)
            TimerCancel(5)
            TimerCancel(6)
            TimerCancel(7)
            TimerCancel(0)
            PRINT "\nDesconectado - reiniciando ciclo de anuncio"
            rc = IniciarAdvertising()
        CASE ELSE
    ENDSELECT
ENDFUNC 1

FUNCTION HndlrCharCccd(BYVAL charHandle AS INTEGER, BYVAL nVal AS INTEGER)
    IF charHandle == hCharTx THEN
        IF nVal != 0 THEN
            ntfyEnabled = 1
        ELSE
            ntfyEnabled = 0
        ENDIF
    ENDIF
ENDFUNC 1

// Guarda un campo de la trama CONF segun su posicion (1=orden .. 8=mac)
FUNCTION GuardarCampo(BYVAL n AS INTEGER, BYVAL valor$)
    SELECT n
        CASE 1
            cfOrden$ = valor$
        CASE 2
            cfLora$ = valor$
        CASE 3
            cfEquipo$ = valor$
        CASE 4
            cfAlias$ = valor$
        CASE 5
            cfVidas$ = valor$
        CASE 6
            cfMunicion$ = valor$
        CASE 7
            cfTiempo$ = valor$
        CASE 8
            cfMac$ = valor$
        CASE ELSE
    ENDSELECT
ENDFUNC 1

// Separa "orden,lora,equipo,alias,vidas,municion,tiempo,mac" por comas
FUNCTION ParsearConf(campos$)
    DIM largo : largo = STRLEN(campos$)
    DIM i, ch, idx, oneChar$
    DIM campoActual$ : campoActual$ = ""
    idx = 1
    i = 0
    WHILE i < largo
        ch = StrGetChr(campos$, i)
        IF ch == 44 THEN
            rc = GuardarCampo(idx, campoActual$)
            idx = idx + 1
            campoActual$ = ""
        ELSE
            oneChar$ = "."
            rc = StrSetChr(oneChar$, ch, 0)
            campoActual$ = campoActual$ + oneChar$
        ENDIF
        i = i + 1
    ENDWHILE
    rc = GuardarCampo(idx, campoActual$)
ENDFUNC 1

// Dato recibido de Sensores por GATT write
FUNCTION HndlrCharValue(BYVAL nConnHandle AS INTEGER, BYVAL charHandle AS INTEGER, BYVAL offset AS INTEGER, BYVAL len AS INTEGER, BYVAL Data$)
    IF charHandle != hCharRx THEN
        EXITFUNC 1
    ENDIF

    PRINT "\nBLE RX: "; Data$

    DIM tag4$ : tag4$ = ""
    IF STRLEN(Data$) >= 4 THEN
        tag4$ = LEFT$(Data$, 4)
    ENDIF

    DIM confTag$ : confTag$ = "CONF"
    DIM runTag$  : runTag$  = "RUN"
    DIM endSTag$ : endSTag$ = "END_S"

    IF confRecibido == 0 && StrCmp(tag4$, confTag$) == 0 THEN
        DIM campos$
        campos$ = MID$(Data$, 4, STRLEN(Data$) - 4)
        rc = ParsearConf(campos$)
        confRecibido = 1
        PRINT "\nCONF guardado -> orden="; cfOrden$; " lora="; cfLora$; " equipo="; cfEquipo$; " alias="; cfAlias$; " vidas="; cfVidas$; " municion="; cfMunicion$; " tiempo="; cfTiempo$; " mac="; cfMac$
        pendienteMsg$ = "ACKCONF"
        TimerStart(3, MSG_DELAY_MS, 0)
    ELSEIF confRecibido == 1 && runRecibido == 0 && STRLEN(Data$) == 3 && StrCmp(Data$, runTag$) == 0 THEN
        runRecibido = 1
        PRINT "\nRUN recibido"
        pendienteMsg$ = "ACKRUN"
        TimerStart(3, MSG_DELAY_MS, 0)
        apCount = 0
        TimerStart(7, AP_INTERVAL_MS, 1)
        TimerStart(0, FIN_TIMEOUT_MS, 0)
    ELSEIF runRecibido == 1 && terminado == 0 && STRLEN(Data$) == 5 && StrCmp(Data$, endSTag$) == 0 THEN
        terminado = 1
        TimerCancel(7)
        TimerCancel(0)
        PRINT "\nEND_S recibido"
        pendienteMsg$ = "ACKEND_S"
        TimerStart(3, MSG_DELAY_MS, 0)
    ENDIF
ENDFUNC 1

// 150ms antes de mandar el mensaje pendiente (ACKCONF / ACKRUN / ACKEND_S / END_A)
FUNCTION HndlrTmr3()
    IF ntfyEnabled == 1 THEN
        rc = BleCharValueNotify(hCharTx, pendienteMsg$)
    ELSE
        PRINT "\nERROR: notify no habilitado, no se pudo mandar "; pendienteMsg$
    ENDIF
    TimerStart(4, MSG_DELAY_MS, 0)
ENDFUNC 1

// 150ms despues de mandarlo, confirmar por consola
FUNCTION HndlrTmr4()
    PRINT "\n"; pendienteMsg$; " enviado"
    IF terminado == 1 THEN
        PRINT "\n=== ApuntadorTEST: programa terminado ===\n"
    ENDIF
ENDFUNC 1

// Cada 10s (mientras esperamos fin) -> preparar el siguiente A_AP
FUNCTION HndlrTmr7()
    apCount = apCount + 1
    DIM n1, n2, n1Str$, n2Str$
    n1 = apCount
    n2 = apCount * 2
    SPRINT #n1Str$, n1
    SPRINT #n2Str$, n2
    apPendiente$ = "A_AP" + n1Str$ + "," + n2Str$
    TimerStart(5, MSG_DELAY_MS, 0)
ENDFUNC 1

// 150ms antes de mandar el A_AP
FUNCTION HndlrTmr5()
    IF ntfyEnabled == 1 THEN
        rc = BleCharValueNotify(hCharTx, apPendiente$)
    ELSE
        PRINT "\nERROR: notify no habilitado, no se pudo mandar "; apPendiente$
    ENDIF
    TimerStart(6, MSG_DELAY_MS, 0)
ENDFUNC 1

// 150ms despues de mandar el A_AP, confirmar por consola
FUNCTION HndlrTmr6()
    PRINT "\n"; apPendiente$; " enviado"
ENDFUNC 1

// Se cumplieron los 2 minutos sin recibir END_S -> mandar END_A y terminar
FUNCTION HndlrTmr0()
    IF terminado == 0 THEN
        terminado = 1
        TimerCancel(7)
        PRINT "\n=== 2 minutos cumplidos, mandando END_A ==="
        pendienteMsg$ = "END_A"
        TimerStart(3, MSG_DELAY_MS, 0)
    ENDIF
ENDFUNC 1

// Arranca el ciclo de anuncio de inmediato (ya con todas las funciones definidas arriba)
rc = IniciarAdvertising()

ONEVENT EVBLEMSG           CALL HndlrBleMsg
ONEVENT EVBLE_ADV_TIMEOUT  CALL HndlrAdvTimeout
ONEVENT EVCHARCCCD         CALL HndlrCharCccd
ONEVENT EVCHARVALUE        CALL HndlrCharValue
ONEVENT EVTMR1             CALL HndlrTmr1
ONEVENT EVTMR2             CALL HndlrTmr2
ONEVENT EVTMR3             CALL HndlrTmr3
ONEVENT EVTMR4             CALL HndlrTmr4
ONEVENT EVTMR5             CALL HndlrTmr5
ONEVENT EVTMR6             CALL HndlrTmr6
ONEVENT EVTMR7             CALL HndlrTmr7
ONEVENT EVTMR0             CALL HndlrTmr0

WAITEVENT
