// SensoresM - Maestro BLE (version base, ya no simulada)
// Espera $CON<mac>\r por UART (mac = 14 hex chars = 7 bytes: tipo+direccion)
// Ciclo: intenta conectar sin parar (respiro corto entre intentos)
// Al conectar (transporte BLE): $ACKCON\r
// Al desconectarse: $DSCON\r, y sigue reintentando de inmediato
// Al terminar discovery + suscripcion (puerto virtual listo): $READY\r
// De ahi en adelante: puente transparente UART <-> BLE, sin analizar contenido

DIM rc
DIM periphAddr$
DIM hConn       : hConn = -1
DIM sAttr, eAttr
DIM rxAttrHndl  : rxAttrHndl = 0
DIM cccdHndl    : cccdHndl = 0
DIM connected   : connected = 0
DIM svcCount    : svcCount = 0
DIM charCount   : charCount = 0
DIM hUuidTarget
hUuidTarget = BleHandleUuid16(0x18EE)
DIM inTargetSvc    : inTargetSvc = 0
DIM notifyCharHndl : notifyCharHndl = 0
DIM nAttributeMTU  : nAttributeMTU = 23
DIM nAttributeLength
DIM nBleMaxPacketLength
DIM uartBuf$    : uartBuf$ = ""
DIM esperandoMac : esperandoMac = 1
DIM macDestino$ : macDestino$ = ""

#define MAC_LEN 14
#define CON_TAG "CON"
#define CON_TAG_LEN 3

#define RETRY_DELAY_MS 500

#define ATTRIBUTE_MTU_KEY_ID            211
#define ATTRIBUTE_DATA_LENGTH_KEY_ID    212
#define USE_STRINT_IN_EVENTS_KEY_ID     213
#define ENABLE_HIGH_BANDWIDTH_KEY_ID    214
#define BLE_MAX_PACKET_LENGTH_KEY_ID    216

#define ATTRIBUTE_MTU_MAXIMUM           247
#define ATTRIBUTE_DATA_LENGTH_MAXIMUM   244
#define BLE_MAX_PACKET_LENGTH           251

FUNCTION ConfigurarDLE()
    rc = NvCfgKeyGet(ATTRIBUTE_MTU_KEY_ID, nAttributeMTU)
    rc = NvCfgKeyGet(ATTRIBUTE_DATA_LENGTH_KEY_ID, nAttributeLength)
    rc = NvCfgKeyGet(BLE_MAX_PACKET_LENGTH_KEY_ID, nBleMaxPacketLength)
    IF (nAttributeMTU != ATTRIBUTE_MTU_MAXIMUM) || (nAttributeLength != ATTRIBUTE_DATA_LENGTH_MAXIMUM) || (nBleMaxPacketLength != BLE_MAX_PACKET_LENGTH) THEN
        rc = NvCfgKeySet(ATTRIBUTE_MTU_KEY_ID, ATTRIBUTE_MTU_MAXIMUM)
        rc = NvCfgKeySet(ATTRIBUTE_DATA_LENGTH_KEY_ID, ATTRIBUTE_DATA_LENGTH_MAXIMUM)
        rc = NvCfgKeySet(USE_STRINT_IN_EVENTS_KEY_ID, 1)
        rc = NvCfgKeySet(ENABLE_HIGH_BANDWIDTH_KEY_ID, 1)
        rc = NvCfgKeySet(BLE_MAX_PACKET_LENGTH_KEY_ID, BLE_MAX_PACKET_LENGTH)
        Reset(0)
    ENDIF
ENDFUNC 0

PRINT "\n=== SensoresM arrancando ===\n"

rc = ConfigurarDLE()
rc = BleGattcOpen(0, 0)

PRINT "\nSensoresM iniciado"
PRINT "\nEsperando $CON<mac>...\n"

// Parsea $CON<mac>\r - guarda la MAC y arranca el ciclo de conexion
FUNCTION ProcesarCon()
    DIM datos$, largo
    datos$ = MID$(uartBuf$, 1, STRLEN(uartBuf$) - 1)
    largo = STRLEN(datos$)

    DIM esperado : esperado = CON_TAG_LEN + MAC_LEN
    IF largo != esperado THEN
        PRINT "\nError: largo incorrecto ("; largo; " vs "; esperado; ")"
        EXITFUNC 0
    ENDIF

    DIM tag$ : tag$ = LEFT$(datos$, CON_TAG_LEN)
    DIM conTag$ : conTag$ = CON_TAG
    IF StrCmp(tag$, conTag$) != 0 THEN
        PRINT "\nError: no empieza con CON"
        EXITFUNC 0
    ENDIF

    macDestino$ = MID$(datos$, CON_TAG_LEN, MAC_LEN)
    periphAddr$ = StrDehexize$(macDestino$)
    esperandoMac = 0

    // Ya no se manda de vuelta la MAC por UART - igual que en Apuntador,
    // solo se conecta y se manda $ACKCON al lograrlo.
    // Iniciar ciclo de conexion en 1s
    TimerStart(2, 1000, 0)
ENDFUNC 1

// Intentar conexion (3s timeout)
FUNCTION IntentarConexion()
    PRINT "\nBuscando..."
    rc = BleConnect(periphAddr$, 3000, 500000, 1000000, 5000000)
ENDFUNC 1

FUNCTION Suscribirse()
    DIM cccdVal$
    cccdVal$ = "\01\00"
    rc = BleGattcWrite(hConn, cccdHndl, cccdVal$)
ENDFUNC 1

FUNCTION HndlrBleMsg(BYVAL nMsgId AS INTEGER, BYVAL nCtx AS INTEGER)
    SELECT nMsgId
        CASE 0
            hConn = nCtx
            PRINT "\nConectado"
            DIM ackMsg$
            ackMsg$ = "$ACKCON\r"
            PRINT ackMsg$
            rc = BleGattcAttributeMtuRequest(hConn)
            IF rc != 0 THEN
                svcCount = 0
                charCount = 0
                rc = BleDiscServiceFirst(hConn, 0, 0)
            ENDIF
        CASE 1
            hConn = -1
            connected = 0
            rxAttrHndl = 0
            cccdHndl = 0
            PRINT "\nDesconectado, razon (nCtx)="
            PRINT nCtx
            DIM dsMsg$
            dsMsg$ = "$DSCON\r"
            PRINT dsMsg$
            PRINT "\nReintentando..."
            TimerStart(2, RETRY_DELAY_MS, 0)
        CASE ELSE
    ENDSELECT
ENDFUNC 1

FUNCTION HndlrAttrMTU(BYVAL hC AS INTEGER, BYVAL nSize AS INTEGER)
    svcCount = 0
    charCount = 0
    rc = BleDiscServiceFirst(hConn, 0, 0)
ENDFUNC 1

FUNCTION HndlrPrimSvc(BYVAL cHndl AS INTEGER, BYVAL svcUuid AS INTEGER, BYVAL sHndl AS INTEGER, BYVAL eHndl AS INTEGER)
    IF sHndl == 0 THEN
        IF rxAttrHndl != 0 && cccdHndl != 0 THEN
            connected = 1
            rc = Suscribirse()
        ENDIF
        EXITFUNC 0
    ENDIF
    svcCount = svcCount + 1
    IF svcUuid == hUuidTarget THEN
        inTargetSvc = 1
    ELSE
        inTargetSvc = 0
    ENDIF
    sAttr = sHndl
    eAttr = eHndl
    rc = BleDiscCharFirst(hConn, 0, sAttr, eAttr)
ENDFUNC 1

FUNCTION HndlrCharDisc(BYVAL cHndl AS INTEGER, BYVAL cUuid AS INTEGER, BYVAL cProp AS INTEGER, BYVAL hVal AS INTEGER, BYVAL isUuid AS INTEGER)
    IF hVal == 0 THEN
        rc = BleDiscServiceNext(hConn)
        IF rc != 0 THEN
            IF rxAttrHndl != 0 && cccdHndl != 0 THEN
                connected = 1
                rc = Suscribirse()
            ENDIF
        ENDIF
        EXITFUNC 1
    ENDIF
    charCount = charCount + 1
    IF inTargetSvc == 1 THEN
        IF (cProp & 0x10) != 0 THEN
            notifyCharHndl = hVal
            cccdHndl = hVal + 1
        ELSEIF (cProp & 0x08) != 0 THEN
            rxAttrHndl = hVal
        ENDIF
    ENDIF
    rc = BleDiscCharNext(hConn)
    IF rc != 0 THEN
        rc = BleDiscServiceNext(hConn)
    ENDIF
ENDFUNC 1

// Suscripcion confirmada -> puerto virtual listo
FUNCTION HndlrAttrWrite(BYVAL cHndl AS INTEGER, BYVAL aHndl AS INTEGER, BYVAL nSts AS INTEGER)
    IF nSts == 0 && aHndl == cccdHndl THEN
        DIM readyMsg$
        readyMsg$ = "$READY\r"
        PRINT readyMsg$
    ENDIF
ENDFUNC 1

// Dato recibido por notify -> reenviar por UART tal cual, sin analizarlo
FUNCTION HndlrAttrNotifyEx(BYVAL hC AS INTEGER, BYVAL hChar AS INTEGER, BYVAL nType AS INTEGER, BYVAL nLen AS INTEGER, BYVAL Data$)
    DIM uartMsg$
    uartMsg$ = "$" + Data$ + "\r"
    PRINT uartMsg$
ENDFUNC 1

// UART - acumular hasta \r
FUNCTION HndlrUartRx()
    DIM chunk$, nBytes, i, ch, oneChar$
    nBytes = UartRead(chunk$)
    IF nBytes == 0 THEN
        EXITFUNC 1
    ENDIF
    i = 0
    WHILE i < nBytes
        ch = StrGetChr(chunk$, i)
        IF ch == 13 THEN
            IF STRLEN(uartBuf$) > 0 THEN
                IF esperandoMac == 1 THEN
                    DIM d
                    d = StrGetChr(uartBuf$, 0)
                    IF d == 36 THEN
                        rc = ProcesarCon()
                    ENDIF
                ELSEIF connected == 1 THEN
                    // Reenviar al BLE (quitar $ si tiene)
                    DIM bleMsg$
                    DIM dl
                    dl = StrGetChr(uartBuf$, 0)
                    IF dl == 36 THEN
                        bleMsg$ = MID$(uartBuf$, 1, STRLEN(uartBuf$) - 1)
                    ELSE
                        bleMsg$ = uartBuf$
                    ENDIF
                    rc = BleGattcWriteCmd(hConn, rxAttrHndl, bleMsg$)
                ENDIF
            ENDIF
            uartBuf$ = ""
        ELSEIF ch != 10 THEN
            oneChar$ = "."
            rc = StrSetChr(oneChar$, ch, 0)
            uartBuf$ = uartBuf$ + oneChar$
        ENDIF
        i = i + 1
    ENDWHILE
ENDFUNC 1

// Timeout de conexion (3s) -> reintentar de inmediato (con respiro corto)
FUNCTION HndlrConnTO()
    PRINT "\nNo encontrada"
    PRINT "\nReintentando..."
    TimerStart(2, RETRY_DELAY_MS, 0)
ENDFUNC 1

// Timer 2 -> intentar conexion
FUNCTION HndlrTmr2()
    rc = IntentarConexion()
ENDFUNC 1

ONEVENT EVBLEMSG           CALL HndlrBleMsg
ONEVENT EVBLE_CONN_TIMEOUT CALL HndlrConnTO
ONEVENT EVATTRIBUTEMTU     CALL HndlrAttrMTU
ONEVENT EVDISCPRIMSVC      CALL HndlrPrimSvc
ONEVENT EVDISCCHAR         CALL HndlrCharDisc
ONEVENT EVATTRWRITE        CALL HndlrAttrWrite
ONEVENT EVATTRNOTIFYEX     CALL HndlrAttrNotifyEx
ONEVENT EVUARTRX           CALL HndlrUartRx
ONEVENT EVTMR2             CALL HndlrTmr2

WAITEVENT
